{
  "name": "spy-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @spy-game/web dev",
    "dev:server": "pnpm --filter @spy-game/server dev",
    "lint": "eslint .",
    "build:core": "pnpm --filter @spy-game/game-core build",
    "typecheck": "pnpm build:core && pnpm -r --if-present typecheck",
    "test": "pnpm build:core && pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "test:e2e": "pnpm build && pnpm --filter @spy-game/e2e test:e2e",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.0.0"
  }
}
